# Godot 4 generated files -------------------------------------------------
# Everything Godot re-creates on import. Safe to delete; never commit.
.godot/
*.translation

# Export output -----------------------------------------------------------
/build/
/export/
export_presets.cfg

# Local tooling -----------------------------------------------------------
# tools/get_godot.sh downloads the engine here so this repo stays source-only.
.tools/

# Python ------------------------------------------------------------------
__pycache__/
*.pyc
.venv/

# Spreadsheet lock files --------------------------------------------------
# Excel leaves these behind while a workbook is open.
~$*.xlsx

# OS noise ----------------------------------------------------------------
.DS_Store
Thumbs.db

# GUT writes its own temporary doubles and result files here.
addons/gut/temp/

# The built web playtest page. It is generated from web/src/ and data/*.json
# by tools/build_web_playtest.py, so it is reproducible rather than a source
# file — and committing a 100 KB generated blob makes every data change look
# like a large diff.
web/playtest.html
